SITE_URL=https://example.com

# Sanity
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only needed for a private dataset
SANITY_READ_TOKEN=

# Newsletter: mailchimp | klaviyo | webhook | log
NEWSLETTER_PROVIDER=log
# Mailchimp: API key ends with the datacenter, e.g. xxxx-us21. Audience ID: Audience > Settings
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# true = confirmation email before subscribing
MAILCHIMP_DOUBLE_OPT_IN=false
# Comma separated tags added to every signup (the form source is added too)
MAILCHIMP_TAGS=website
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=
# Generic JSON POST (Laylo via Zapier/Make, Mailchimp via Make, etc.)
NEWSLETTER_WEBHOOK_URL=
# Used when a phone number is typed without country code (07x... -> +467x...)
DEFAULT_PHONE_COUNTRY_CODE=46

# Bandsintown (request an app_id from Bandsintown for Artists)
BANDSINTOWN_APP_ID=
