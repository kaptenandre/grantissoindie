---
import type {SocialLink} from '../lib/types'
import {platformLabel} from '../lib/platforms'

interface Props {
  socials?: SocialLink[]
}

const {socials = []} = Astro.props
---

{
  socials.length > 0 && (
    <ul class="socials" aria-label="Socials">
      {socials.map((s) => (
        <li>
          <a href={s.url} target={s.url.startsWith('mailto:') ? undefined : '_blank'} rel="me noopener">
            {platformLabel(s.platform)}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  a {
    color: #fff;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
