---
import {album} from '../lib/triptyk'
import {releasedLyrics} from '../lib/lyrics'

const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII']
const byTitle = new Map(releasedLyrics.map((s) => [s.title, s.lyrics]))
const stanzas = (text: string) => text.split(/\n\s*\n/).map((s) => s.split('\n'))
const rows = album.tracks.map((title, i) => ({i, n: roman[i], title, lyrics: byTitle.get(title)}))
// Desktop shows three columns (I–V, VI–IX, X–XIII); each is its own list so opening a song only moves its column
const columns = [rows.slice(0, 5), rows.slice(5, 9), rows.slice(9)]
---

<section id="lyrics" class="lyrics" aria-labelledby="lyrics-title" data-reveal>
  <h2 id="lyrics-title" class="label" data-line style="--i: 0">Lyrics</h2>
  <div class="cols">
  {columns.map((col) => (
  <ol class="songs" start={col[0].i + 1}>
    {
      col.map((row) => (
        <li data-line style={`--i: ${row.i + 1}`}>
          {row.lyrics ? (
            <details data-lyric>
              <summary>
                <span class="n">{row.n}</span>
                <span class="title">{row.title}</span>
                <span class="toggle" aria-hidden="true" />
              </summary>
              <div class="panel">
                <div class="text">
                  {stanzas(row.lyrics).map((lines) => (
                    <p>
                      {lines.map((l, j) => (
                        <>
                          {j > 0 && <br />}
                          {l}
                        </>
                      ))}
                    </p>
                  ))}
                </div>
              </div>
            </details>
          ) : (
            <div class="row unreleased">
              <span class="n">{row.n}</span>
              <span class="title">{row.title}</span>
            </div>
          )}
        </li>
      ))
    }
  </ol>
  ))}
  </div>
</section>

<script>
  // Smooth open/close: animate the panel height instead of the default jump
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
  document.querySelectorAll<HTMLDetailsElement>('[data-lyric]').forEach((details) => {
    const summary = details.querySelector('summary')!
    const panel = details.querySelector<HTMLElement>('.panel')!
    let anim: Animation | undefined
    summary.addEventListener('click', (e) => {
      if (reduce) return
      e.preventDefault()
      anim?.cancel()
      const opening = !details.open
      if (opening) details.open = true
      const full = panel.scrollHeight
      const from = opening ? 0 : panel.offsetHeight
      const to = opening ? full : 0
      details.classList.toggle('is-open', opening)
      anim = panel.animate([{height: `${from}px`}, {height: `${to}px`}], {
        duration: Math.min(900, 350 + full * 0.25),
        easing: 'cubic-bezier(0.25, 0.1, 0.25, 1)',
      })
      anim.onfinish = () => {
        if (!opening) details.open = false
        anim = undefined
      }
    })
    details.addEventListener('toggle', () => details.classList.toggle('is-open', details.open))
  })
</script>

<style>
  /* Compact, on black. Anchored to the top so an opened song pushes the list downwards */
  .lyrics {
    padding: clamp(48px, 6vw, 96px) var(--gutter);
    background: #000;
  }
  .label {
    margin: 0 0 20px;
    font-size: 0.875rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--caps-tracking);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 0 40px;
  }
  .songs {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(255 255 255 / 0.6);
  }
  .songs > li {
    border-bottom: 1px solid rgb(255 255 255 / 0.6);
  }
  summary,
  .row {
    display: grid;
    grid-template-columns: 3.2em 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding: 8px 0 6px;
  }
  summary {
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .n {
    font-size: 0.8125rem;
    letter-spacing: var(--caps-tracking);
  }
  .title {
    font-family: 'WT Kormelink', var(--font-sans);
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    line-height: 1;
  }
  .unreleased {
    opacity: 0.45;
  }
  summary:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  /* Plus that turns into a minus */
  .toggle {
    position: relative;
    align-self: center;
    width: 16px;
    height: 16px;
  }
  .toggle::before,
  .toggle::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: #fff;
    transition: transform 0.5s ease;
  }
  .toggle::after {
    transform: rotate(90deg);
  }
  details.is-open .toggle::after {
    transform: rotate(0deg);
  }
  .panel {
    overflow: hidden;
  }
  .text {
    padding: 6px 0 28px calc(3.2em + 12px);
    font-size: 0.875rem;
    line-height: 1.45;
    transition: opacity 0.6s ease 0.15s;
  }
  details:not(.is-open) .text {
    opacity: 0;
  }
  .text p {
    margin: 0 0 1.1em;
    break-inside: avoid;
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
    }
    .songs + .songs {
      border-top: 0;
    }
  }
  @media (max-width: 600px) {
    summary,
    .row {
      grid-template-columns: 2.6em 1fr auto;
    }
    .text {
      padding-left: 0;
    }
  }
</style>
