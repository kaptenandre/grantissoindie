---
import type {Release} from '../lib/types'
import {platformLabel} from '../lib/platforms'

interface Props {
  release: Release
  showLyrics?: boolean
}

const {release, showLyrics = false} = Astro.props
// Typographic apostrophes: "C'mon" -> "C’mon"
const title = release.title.replace(/'/g, '’')
const TZ = 'Europe/Stockholm'

/** Midnight (Stockholm time) after a YYYY-MM-DD date */
const midnightAfter = (ymd: string) => {
  const next = new Date(`${ymd}T12:00:00Z`)
  next.setUTCDate(next.getUTCDate() + 1)
  const day = next.toISOString().slice(0, 10)
  const offset =
    new Intl.DateTimeFormat('en', {timeZone: TZ, timeZoneName: 'longOffset'})
      .formatToParts(new Date(`${day}T00:00:00Z`))
      .find((p) => p.type === 'timeZoneName')
      ?.value.replace('GMT', '') || '+00:00'
  return new Date(`${day}T00:00:00${offset}`)
}

// Pre-save until it goes live: the exact release time if set, otherwise midnight after the release date.
// This is the build-time state; the script below re-checks in the browser so the page flips by itself.
const outAt = release.releaseAt ? new Date(release.releaseAt) : midnightAfter(release.releaseDate)
const isOut = Date.now() >= outAt.getTime()
const today = new Intl.DateTimeFormat('en-CA', {timeZone: TZ}).format(new Date())
const date = new Intl.DateTimeFormat('en-GB', {day: 'numeric', month: 'long'}).format(new Date(release.releaseDate))
const upcoming = release.releaseDate === today ? 'Out today' : `Out ${date}`
const type = release.type === 'ep' ? 'EP' : release.type === 'album' ? 'Album' : 'Single'
const links = release.streamingLinks?.filter((l) => l.url) ?? []
const external = {target: '_blank', rel: 'noopener'}
---

<section
  class="release"
  aria-labelledby="release-title"
  data-release
  data-out-at={outAt.toISOString()}
  data-release-date={release.releaseDate}
  data-upcoming-label={`Out ${date}`}
>
  <div class="title-box" data-fit-box>
    <h2 id="release-title" class:list={['title', {caps: release.titleUppercase}]} data-fit>{title}</h2>
  </div>

  <div class="details">
    <p class="meta">{type} · <span data-status>{isOut ? 'Out now' : upcoming}</span></p>
    {
      (links.length > 0 || release.smartLink) && (
        <ul class="stream" aria-label={`Listen to ${release.title}`}>
          {release.smartLink && (
            <li>
              <a class="primary" href={release.smartLink} {...external} data-cta>
                {isOut ? 'Listen' : 'Pre-save'}
              </a>
            </li>
          )}
          {links.map((l) => (
            <li>
              <a href={l.url} {...external}>
                {platformLabel(l.platform)}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      showLyrics && release.tracks?.some((t) => t.hasLyrics) && (
        <ul class="tracks">
          {release.tracks.map((t) => (
            <li>{t.hasLyrics ? <a href={`/lyrics/${t.slug}`}>{t.title}</a> : t.title}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<script>
  // Scale each title to the largest size that fits its box (width and height), wrapping only between words.
  const fit = (title: HTMLElement) => {
    const box = title.parentElement!
    let lo = 16
    let hi = Math.max(box.clientWidth, box.clientHeight)
    while (hi - lo > 1) {
      const mid = Math.floor((lo + hi) / 2)
      title.style.fontSize = `${mid}px`
      const fits = title.scrollWidth <= box.clientWidth && title.offsetHeight <= box.clientHeight
      if (fits) lo = mid
      else hi = mid
    }
    title.style.fontSize = `${lo}px`
    title.dataset.fitted = ''
  }

  // Pre-save -> Listen when the release goes live, also in a tab that is already open
  document.querySelectorAll<HTMLElement>('[data-release]').forEach((section) => {
    const outAt = Date.parse(section.dataset.outAt!)
    const status = section.querySelector('[data-status]')
    const cta = section.querySelector('[data-cta]')
    const update = () => {
      const out = Date.now() >= outAt
      const today = new Intl.DateTimeFormat('en-CA', {timeZone: 'Europe/Stockholm'}).format(new Date())
      if (status) status.textContent = out ? 'Out now' : section.dataset.releaseDate === today ? 'Out today' : section.dataset.upcomingLabel!
      if (cta) cta.textContent = out ? 'Listen' : 'Pre-save'
      return out
    }
    const wait = outAt - Date.now()
    if (!update() && wait < 2 ** 31 - 1) setTimeout(update, wait + 500)
  })

  const titles = [...document.querySelectorAll<HTMLElement>('[data-fit]')]

  // Design preview: ?caps / ?caps=0 forces capitals on or off without touching Sanity
  const caps = new URLSearchParams(location.search).get('caps')
  if (caps !== null) titles.forEach((t) => t.classList.toggle('caps', caps !== '0'))
  const fitAll = () => titles.forEach(fit)

  // Measure with the real font, then keep fitting as the viewport changes
  document.fonts.load('400 1em "WT Kormelink"').finally(fitAll)
  const observer = new ResizeObserver(fitAll)
  titles.forEach((t) => observer.observe(t.parentElement!))
</script>

<style>
  .release {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 0;
  }

  /* The title is taken out of flow so the box size comes from the layout, not the text */
  .title-box {
    position: relative;
    flex: 1;
    min-height: 120px;
  }
  .title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    font-family: 'WT Kormelink', var(--font-sans);
    font-weight: 400;
    /* No-JS fallback; the script replaces this with an exact fit */
    font-size: clamp(3.5rem, 17vw, 16rem);
    line-height: 0.88;
    letter-spacing: -0.01em;
    text-wrap: balance;
    overflow-wrap: normal;
    hyphens: manual;
  }
  .title.caps {
    text-transform: uppercase;
    /* Capitals need a little more air than lowercase */
    letter-spacing: 0.01em;
    line-height: 0.92;
  }

  .details {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
  }
  .meta {
    margin: 0;
    font-size: 0.875rem;
    letter-spacing: var(--caps-tracking);
    word-spacing: var(--caps-word-spacing);
    text-transform: uppercase;
  }
  .stream {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stream a {
    display: inline-block;
    padding: calc(10px - var(--optical-shift)) 14px calc(10px + var(--optical-shift));
    border: 1px solid #fff;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.8125rem;
    letter-spacing: var(--caps-tracking);
    word-spacing: var(--caps-word-spacing);
    line-height: 1;
  }
  .stream a.primary,
  .stream a:hover {
    background: #fff;
    color: #000;
  }
  .tracks {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  @media (max-width: 600px) {
    .release {
      gap: 12px;
    }
    .title-box {
      min-height: 80px;
    }
    .details {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }
    /* Phones: one full-width Listen button, platforms as a compact row of large tap targets */
    .stream {
      gap: 0 18px;
    }
    .stream li:has(.primary) {
      flex-basis: 100%;
      margin-bottom: 2px;
    }
    .stream a.primary {
      display: block;
      padding: calc(14px - var(--optical-shift)) 12px calc(14px + var(--optical-shift));
      text-align: center;
    }
    .stream a:not(.primary) {
      padding: 10px 0;
      border: 0;
      background: none;
      color: #fff;
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }
</style>
