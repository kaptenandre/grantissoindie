---
import {platformLabel} from '../lib/platforms'
import type {SiteSettings} from '../lib/types'

interface Props {
  settings: SiteSettings
}

const {settings} = Astro.props
const socials = settings.socials ?? []
---

<section id="socials" class="signup" aria-label="Socials" data-reveal>
  {
    socials.length > 0 && (
      <ul class="socials" aria-label="Socials">
        {socials.map((s, i) => (
          <li data-line style={`--i: ${i}`}>
            <a href={s.url} target="_blank" rel="me noopener">
              {platformLabel(s.platform)}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .signup {
    padding: clamp(64px, 10vw, 140px) var(--gutter) clamp(32px, 4vw, 56px);
    background: #000;
  }
  /* Desktop: one column per platform across the page. Phones: stacked */
  .socials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .socials a {
    color: #fff;
    text-decoration: none;
    font-family: 'WT Kormelink', var(--font-sans);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    line-height: 1.05;
  }
  .socials a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  @media (max-width: 600px) {
    .socials {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
