---
import {album} from '../lib/triptyk'
const date = new Intl.DateTimeFormat('en-GB', {day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'}).format(
  new Date(`${album.releaseDate}T12:00:00Z`),
)
const facts = [
  ['Format', album.vinyl.format],
  ['Tracks', String(album.tracks.length)],
  ['Edition', album.vinyl.edition],
  ['Release', date],
  ['Label', `${album.label} · ${album.vinyl.catalogue}`],
  ['Price', album.vinyl.price],
]
const preorder = album.preorderUrl || undefined
---

<section id="vinyl" class="vinyl" aria-labelledby="vinyl-title" data-reveal>
  <img
    data-reveal-bg
    class="mockup"
    src="/triptyk/vinyl-900.webp"
    srcset="/triptyk/vinyl-900.webp 900w, /triptyk/vinyl-1600.webp 1600w"
    sizes="(max-width: 800px) 80vw, 36vw"
    width="1600"
    height="1052"
    alt={`${album.title} on vinyl`}
    loading="lazy"
    decoding="async"
  />
  <div class="info">
    <h2 id="vinyl-title" data-line style="--i: 0">{album.title}</h2>
    <dl>
      {
        facts.map(([k, v], i) => (
          <div data-line style={`--i: ${i + 1}`}>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
    <a class="cta" data-line style={`--i: ${facts.length + 1}`} href={preorder ?? '#'} {...(preorder ? {target: '_blank', rel: 'noopener'} : {})}>Pre-order now</a>
  </div>
</section>

<style>
  .vinyl {
    display: grid;
    /* Small mockup with plenty of negative space around it */
    grid-template-columns: minmax(0, 36vw) minmax(0, 320px);
    justify-content: center;
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    padding: clamp(64px, 9vw, 140px) var(--gutter) clamp(48px, 6vw, 96px);
    background: #000;
  }
  .mockup {
    width: 100%;
    height: auto;
  }
  h2 {
    margin: 0 0 24px;
    font-family: 'WT Kormelink', var(--font-sans);
    font-weight: 400;
    font-size: clamp(2.25rem, 3.4vw, 3.5rem);
    line-height: 0.95;
  }
  dl {
    margin: 0 0 28px;
    font-size: 0.875rem;
  }
  dl div {
    display: grid;
    grid-template-columns: 5.5em 1fr;
    gap: 16px;
    padding: 9px 0;
    border-top: 1px solid rgb(255 255 255 / 0.35);
  }
  dl div:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.35);
  }
  dt {
    text-transform: uppercase;
    letter-spacing: var(--caps-tracking);
  }
  dd {
    margin: 0;
  }
  .cta {
    display: inline-block;
    padding: calc(14px - var(--optical-shift)) 22px calc(14px + var(--optical-shift));
    background: #fff;
    color: #000;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.875rem;
    letter-spacing: var(--caps-tracking);
    word-spacing: var(--caps-word-spacing);
    line-height: 1;
  }
  @media (max-width: 800px) {
    .vinyl {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .mockup {
      width: 80%;
      justify-self: center;
    }
    .cta {
      display: block;
      text-align: center;
    }
  }
</style>
