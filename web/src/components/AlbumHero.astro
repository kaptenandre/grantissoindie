---
import {album} from '../lib/triptyk'
---

<!-- First screen: only the logo over the video. Links and sign-up follow on the next screen. -->
<section class="album" aria-labelledby="album-title">
  <h2 id="album-title" class="logo">
    <img src="/triptyk/logo.webp" alt={album.title} width="2400" height="400" fetchpriority="high" />
  </h2>
</section>

<style>
  .album {
    flex: 1;
    display: flex;
    align-items: flex-end;
    min-height: 0;
  }
  .logo {
    margin: 0;
    width: 100%;
  }
  .logo img {
    width: 100%;
    height: auto;
  }
</style>
