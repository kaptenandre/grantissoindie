---
import {album} from '../lib/triptyk'

const date = new Intl.DateTimeFormat('en-GB', {day: 'numeric', month: 'long', timeZone: 'UTC'}).format(
  new Date(`${album.releaseDate}T12:00:00Z`),
)
---

<section class="album" aria-labelledby="album-title">
  <div class="logo-box">
    <h2 id="album-title" class="logo">
      <img src="/triptyk/logo.webp" alt={album.title} width="2400" height="400" fetchpriority="high" />
    </h2>
  </div>

  <div class="details">
    <p class="meta">The new album · Out {date}</p>
    <ul class="links">
      <li><a href="#tracklist">Tracklist</a></li>
      <li><a href="#credits">Credits</a></li>
    </ul>
  </div>
</section>

<style>
  .album {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 16px;
    min-height: 0;
  }
  .logo-box {
    flex: 1;
    display: flex;
    align-items: flex-end;
    min-height: 60px;
  }
  .logo {
    margin: 0;
    width: 100%;
  }
  .logo img {
    width: 100%;
    height: auto;
  }
  .details {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
  }
  .meta {
    margin: 0;
    font-size: 0.875rem;
    letter-spacing: var(--caps-tracking);
    word-spacing: var(--caps-word-spacing);
    text-transform: uppercase;
  }
  .links {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-block;
    padding: calc(10px - var(--optical-shift)) 14px calc(10px + var(--optical-shift));
    border: 1px solid #fff;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.8125rem;
    letter-spacing: var(--caps-tracking);
    word-spacing: var(--caps-word-spacing);
    line-height: 1;
  }
  .links a:hover {
    background: #fff;
    color: #000;
  }
  @media (max-width: 600px) {
    .album {
      gap: 12px;
    }
    .details {
      flex-direction: column;
      align-items: stretch;
    }
    .links li {
      flex: 1;
    }
    .links a {
      display: block;
      padding: calc(14px - var(--optical-shift)) 12px calc(14px + var(--optical-shift));
      text-align: center;
    }
  }
</style>
