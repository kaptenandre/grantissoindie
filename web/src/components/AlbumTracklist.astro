---
import {album} from '../lib/triptyk'
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII']
---

<section id="tracklist" class="tracklist" aria-labelledby="tracklist-title">
  <h2 id="tracklist-title" class="visually-hidden">Tracklist</h2>
  <img
    class="photo"
    src="/triptyk/photo-1200.jpg"
    srcset="/triptyk/photo-1200.jpg 1200w, /triptyk/photo-2200.jpg 2200w"
    sizes="100vw"
    alt=""
    loading="lazy"
    decoding="async"
  />
  <!-- White-on-black handwriting: screen blend drops the black so only the type sits on the photo.
       The square image is centred on the hub of the flower, so it turns around its true centre. -->
  <img
    class="type"
    src="/triptyk/tracklist-round-1200.jpg"
    srcset="/triptyk/tracklist-round-1200.jpg 1200w, /triptyk/tracklist-round-2200.jpg 2200w"
    sizes="min(100vw, 96svh)"
    width="2200"
    height="2200"
    alt=""
    loading="lazy"
    decoding="async"
  />
  <ol class="visually-hidden">
    {album.tracks.map((t, i) => <li>{roman[i]}. {t}</li>)}
  </ol>
</section>

<style>
  .tracklist {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow: hidden;
    background: #000;
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .type {
    position: relative;
    width: min(100vw, 96svh);
    height: auto;
    mix-blend-mode: screen;
    animation: spin 240s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .type {
      animation: none;
    }
  }
  /* Phones: show the whole photo, type on top at the same size */
  @media (max-aspect-ratio: 3/4) {
    .tracklist {
      min-height: 0;
      aspect-ratio: 3296 / 4000;
    }
  }
</style>
