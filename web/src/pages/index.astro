---
import Base from '../layouts/Base.astro'
import BackgroundVideo from '../components/BackgroundVideo.astro'
import TopNav from '../components/TopNav.astro'
import Socials from '../components/Socials.astro'
import Credits from '../components/Credits.astro'
import FeaturedRelease from '../components/FeaturedRelease.astro'
import Newsletter from '../components/Newsletter.astro'
import Shows from '../components/Shows.astro'
import AlbumHero from '../components/AlbumHero.astro'
import AlbumTracklist from '../components/AlbumTracklist.astro'
import AlbumVinyl from '../components/AlbumVinyl.astro'
import AlbumSignup from '../components/AlbumSignup.astro'
import AlbumLyrics from '../components/AlbumLyrics.astro'
import {getSettings} from '../lib/settings'
import {album} from '../lib/triptyk'
import {SITE_MODE} from 'astro:env/server'

const s = await getSettings()
const isAlbum = SITE_MODE === 'album'
// Album mode: Baby video, 3:2 on desktop and 9:16 on portrait phones
const video = isAlbum ? album.video : s.backgroundVideo
---

<Base>
  {
    !isAlbum && s.featuredRelease && (
      <link slot="head" rel="preload" href="/fonts/wt-kormelink-roman.woff2" as="font" type="font/woff2" crossorigin />
    )
  }
  <BackgroundVideo video={video} />
  <div class:list={['screen', {album: isAlbum}]}>
  <TopNav artistName={s.artistName} links={s.navLinks} />

  <main>
    <h1 class="visually-hidden">{s.artistName}</h1>
    {s.tagline && <p class="tagline">{s.tagline}</p>}
    {isAlbum && <AlbumHero />}
    {!isAlbum && s.featuredRelease && <FeaturedRelease release={s.featuredRelease} showLyrics={s.lyricsEnabled} />}
    {
      s.shows?.enabled && (
        <Shows server:defer artist={s.shows.bandsintownArtist} emptyText={s.shows.emptyText}>
          <p slot="fallback" />
        </Shows>
      )
    }
    {s.newsletter?.enabled !== false && <Newsletter config={s.newsletter ?? {}} collectCountry={isAlbum} />}
  </main>
  </div>

  {isAlbum && <AlbumTracklist />}
  {isAlbum && <AlbumVinyl />}
  {isAlbum && <AlbumLyrics />}
  {isAlbum && <AlbumSignup settings={s} />}

  <footer class:list={{album: isAlbum}}>
    {/* Album mode shows the socials large in the signup section above */}
    {!isAlbum && <Socials socials={s.socials} />}
    <a class="legal" href="/privacy">Privacy &amp; Cookies</a>
    <Credits />
    {s.lyricsEnabled && <a href="/lyrics">Lyrics</a>}
  </footer>
</Base>

<script>
  // Album mode: reveal sections as they scroll into view (no-op when there are none)
  const sections = document.querySelectorAll('[data-reveal]')
  if ('IntersectionObserver' in window && sections.length) {
    document.documentElement.classList.add('reveal-ready')
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in')
            io.unobserve(e.target)
          }
        }
      },
      {threshold: 0.2},
    )
    sections.forEach((el) => io.observe(el))
  }

  // Album mode: once the first screen is out of view, hide and pause the fixed video so it can't show through
  // at the bottom (iOS overscroll, gaps between sections)
  const hero = document.querySelector('.screen.album')
  const bgVideo = document.querySelector<HTMLVideoElement>('[data-bg-video]')
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      const past = !entry.isIntersecting
      document.documentElement.classList.toggle('past-hero', past)
      if (!bgVideo) return
      if (past) bgVideo.pause()
      else if (bgVideo.autoplay) bgVideo.play().catch(() => {})
    }).observe(hero)
  }
</script>

<style>
  /* One screen: header top, footer pinned to the bottom, content fills the space between */
  :global(body) {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  /* Header + main fill the first screen; in album mode the sections and footer follow below */
  .screen {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .screen.album {
    min-height: 100svh;
    padding-bottom: var(--gutter);
  }
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 40px;
    min-height: 0;
    padding: 0 var(--gutter);
  }
  @media (max-width: 600px) {
    main {
      gap: 22px;
    }
  }
  .tagline {
    margin: 0;
    color: var(--muted);
  }
  .legal {
    color: #fff;
    text-decoration: none;
    margin-right: auto;
  }
  .legal:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Album mode: the page ends on black, not on the fixed video */
  footer.album {
    background: #000;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    color: #fff;
    gap: 16px;
    padding: var(--gutter);
    font-size: 0.875rem;
  }
  /* Phones: socials and marks on a single row */
  @media (max-width: 600px) {
    footer {
      flex-wrap: nowrap;
      gap: clamp(8px, 2.8vw, 12px);
      font-size: clamp(0.625rem, 3.25vw, 0.8125rem);
    }
    footer :global(.socials) {
      font-size: inherit;
      flex-wrap: nowrap;
      gap: clamp(8px, 2.8vw, 12px);
    }
  }
</style>
